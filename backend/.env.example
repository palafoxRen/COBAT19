# ===== Supabase =====
# URL del proyecto y anon key (Project Settings > API). El anon key es público.
SUPABASE_DB_URL=postgresql://<usuario>.<referencia>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<referencia>.supabase.co
SUPABASE_ANON_KEY=<anon_key_jwt>
SUPABASE_BUCKET=uploads

# ===== Backend =====
PORT=5000
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Origenes permitidos por CORS (separados por coma). En Vercel el frontend y el
# backend viven en dominios distintos, asi que aqui va el dominio del frontend.
CORS_ORIGINS=https://<frontend>.vercel.app

# Contrasenas iniciales de los usuarios base (seed). Se usan con `npm run seed`.
SEED_MATUTINO_PASSWORD=password_matutino_min8
SEED_VESPERTINO_PASSWORD=password_vespertino_min8

# NODE_ENV=production
